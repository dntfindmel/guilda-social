# frontend/Dockerfile
FROM node:20-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --legacy-peer-deps
RUN npm install typescript@5.5.4 --save-dev --legacy-peer-deps
COPY . .
RUN npm run build:prod

FROM node:20-alpine
WORKDIR /app
COPY --from=build /app/dist/guilda-social-frontend /app/public
COPY server.js /app/server.js
EXPOSE 80
CMD ["node", "server.js"]
